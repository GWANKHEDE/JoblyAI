# Optional: base64-encoded 32-byte AES key. If omitted, a local .data/.key is created.
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
GSBOT_ENCRYPTION_KEY=

# Optional: enables AI interview coaching. Keep secrets in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
